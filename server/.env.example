# ============================================================
# server (Express + Socket.IO) — environment variables
# Used locally and on Back4App Containers. Copy to server/.env for local dev.
# ============================================================

# Port the Socket.IO server listens on (default 4000)
PORT=4000

# Postgres connection string (Neon). Must match root .env DATABASE_URL
DATABASE_URL=

# E2B sandbox API key
E2B_API_KEY=

# Clerk secret key (used to verify socket JWT auth)
CLERK_SECRET_KEY=

# Optional: 32-byte hex key to encrypt user API keys in the DB
ENCRYPTION_KEY=

# Optional: Dokku credentials — only needed if you deploy user apps to Dokku
DOKKU_HOST=
DOKKU_USERNAME=
DOKKU_KEY=