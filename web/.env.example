# ============================================================
# web (Next.js frontend) — environment variables
# NOTE: next.config.mjs also loads the ROOT .env, so this file
# only needs the web-specific values. Copy to web/.env if needed.
# In production these are set in CI / Cloudflare instead.
# ============================================================

# Clerk publishable key (also in root .env)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public URL of the deployed frontend
# Local: http://localhost:3000  |  Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the Socket.IO backend (Back4App Containers in production)
# Local: http://localhost:4000  |  Prod: https://<your-app>.back4app.io
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Optional Clerk URL overrides (defaults below)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/sign-up
