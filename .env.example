# ============================================================
# Sandbox (GitWit) monorepo — root environment variables
# Copy this file to .env and fill in your values.
# ============================================================

# Connection string for a Postgres database (Neon: https://neon.tech)
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# API key for E2B, obtainable at https://e2b.dev/
E2B_API_KEY=

# API key and publishable key for Clerk, obtainable at https://clerk.com/
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# GitHub OAuth App (required by the app)
# Create one at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URLs (web)
# In production: NEXT_PUBLIC_APP_URL=https://your-domain.com
#                NEXT_PUBLIC_SERVER_URL=https://<your-app>.back4app.io
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Optional: 32-byte hex key used to encrypt user API keys in the DB
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# API key for OpenAI, obtainable at https://openai.com/api/
OPENAI_API_KEY=

# API key for Anthropic, obtainable at https://console.anthropic.com/api
ANTHROPIC_API_KEY=

# Optional: As an alternative to Anthropic, you can use AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_MODEL_ID=qwen.qwen3-32b-v1:0
# AWS_MODEL_ID=qwen.qwen3-coder-30b-a3b-v1:0

# Optional: Dokku credentials for deployments
DOKKU_HOST=
DOKKU_USERNAME=
DOKKU_KEY=
